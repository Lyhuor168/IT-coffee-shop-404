# Base URL of the Laravel API, including the /api prefix.
VITE_API_BASE_URL=http://localhost:8000/api

# Origin this frontend is served from — used to build the Telegram widget's
# redirect URL. Without this set, the Telegram login button won't render.
VITE_FRONTEND_URL=http://localhost:5173

# Bot username from @BotFather, no @ prefix. Must match TELEGRAM_BOT_USERNAME
# in the backend's .env.
VITE_TELEGRAM_BOT_USERNAME=
